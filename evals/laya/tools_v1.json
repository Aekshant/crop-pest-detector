{
  "version": 1,
  "note": "Eval copy of the Laya tool schema v1 (design doc, 'Tools (schema v1)'). labels = ml/labels_v1.json ids minus 'unknown' (check_cases.py enforces this).",
  "labels": [
    "healthy",
    "early_blight",
    "late_blight",
    "septoria_leaf_spot",
    "bacterial_spot",
    "yellow_leaf_curl_virus",
    "mosaic_virus",
    "tuta_absoluta",
    "whitefly",
    "fruit_borer",
    "spider_mites"
  ],
  "tools": {
    "scan_image": {
      "args": {
        "field_id": {
          "type": "string",
          "required": false
        }
      },
      "needsNetwork": false,
      "sideEffect": false
    },
    "get_scan_history": {
      "args": {
        "field_id": {
          "type": "string",
          "required": false
        },
        "days": {
          "type": "integer",
          "required": false
        }
      },
      "needsNetwork": false,
      "sideEffect": false
    },
    "compare_scans": {
      "args": {
        "scan_a": {
          "type": "string",
          "required": true
        },
        "scan_b": {
          "type": "string",
          "required": true
        }
      },
      "needsNetwork": false,
      "sideEffect": false
    },
    "get_treatment_info": {
      "args": {
        "label": {
          "type": "label",
          "required": true
        }
      },
      "needsNetwork": false,
      "sideEffect": false
    },
    "get_weather": {
      "args": {
        "location": {
          "type": "string",
          "required": true
        }
      },
      "needsNetwork": true,
      "sideEffect": false
    },
    "record_observation": {
      "args": {
        "text": {
          "type": "string",
          "required": true
        }
      },
      "needsNetwork": false,
      "sideEffect": true
    },
    "create_reminder": {
      "args": {
        "when": {
          "type": "datetime",
          "required": true
        },
        "text": {
          "type": "string",
          "required": true
        }
      },
      "needsNetwork": false,
      "sideEffect": true
    }
  }
}
